+// (the front end's TV), so Menu_HandleMouseMove leaves it alone; the port finds where on that texture the player points
+// (tx, ty: texture pixels) and this focuses the item there, as a mouse over a flat menu would (its onFocus scripts move
+// the TV's highlight). The rects are placed with the window's own ScreenPlacement, the one the menu is drawn with.
+// 1 when it focused an item.
+int Menu_PointAt3D(int localClientNum, UiContext *dc, menuDef_t *menu, float tx, float ty)
+{
+    if ( !menu || menu->ui3dWindowId < 0 )
+        return 0;
+    const ScreenPlacement *scrPlace = R_UI3D_ScrPlaceFromTextureWindow(menu->ui3dWindowId);
+    for ( int i = menu->itemCount - 1; i >= 0; --i )
+    {
+        itemDef_s *item = menu->items[i];
+        if ( (Window_GetDynamicFlags(dc->contextIndex, &item->window) & 0x4004) == 0
+            || ((item->dvarFlags & 3) != 0 && !Item_EnableShowViaDvar(item, 1))
+            || ((item->dvarFlags & 0xC) != 0 && !Item_EnableShowViaDvar(item, 4))
+            || !Item_IsVisible(localClientNum, dc->contextIndex, item) )
+            continue;
+        const rectDef_s *rect = Window_GetRect(&item->window);
+        rectDef_s placed = *rect;
+        ScrPlace_ApplyRect(scrPlace, &placed.x, &placed.y, &placed.w, &placed.h, rect->horzAlign, rect->vertAlign);
+        if ( tx < placed.x || tx > placed.x + placed.w || ty < placed.y || ty > placed.y + placed.h )
+            continue;
+        if ( Window_HasFocus(dc->contextIndex, &item->window) )
+            return 0;
+        // x, y only matter to text items' own rect test, which uses the flat placement: none here
+        if ( Item_SetFocus(localClientNum, dc, item, -100000.0f, -100000.0f) )
+            return 1;
+    }
+    return 0;
+}
