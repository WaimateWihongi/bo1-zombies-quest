<?xml version="1.0" encoding="utf-8"?>
<!-- An immersive OpenXR app (milestone 5): the VR intent categories make the Quest launch it in the
     headset; the Khronos loader (lib/arm64-v8a/libopenxr_loader.so) finds the runtime through the
     broker queries below. Without a runtime the host falls back to drawing in the window.
     Debuggable while in development: `adb shell run-as` and debuggers can reach the process. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bo1zombies.quest"
    android:versionCode="2"
    android:versionName="0.2-m5">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="32" />
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
    <!-- the game's client and server talk over loopback UDP, even in solo zombies -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application
        android:label="BO1 Zombies VR"
        android:hasCode="false"
        android:debuggable="true"
        android:extractNativeLibs="false">
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:excludeFromRecents="false"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
